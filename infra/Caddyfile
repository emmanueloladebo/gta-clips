:80 {
    # Encode responses
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Proxy API and Docs
    handle /api/* {
        reverse_proxy api:8000 {
            transport http {
                response_header_timeout 180s
            }
        }
    }

    handle /docs* {
        reverse_proxy api:8000
    }

    handle /openapi.json {
        reverse_proxy api:8000
    }

    # Proxy Web Frontend
    handle {
        reverse_proxy web:80
    }
}
