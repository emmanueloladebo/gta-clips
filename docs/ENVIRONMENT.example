# Copy to .env on the CLOUD SERVER only. Do not commit actual values.
APP_ENV=production
PUBLIC_BASE_URL=https://YOUR_DOMAIN
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@postgres:5432/clips
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_VALUE
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL_ID=CONFIGURE_VERIFIED_MODEL
FALLBACK_LLM_PROVIDER=disabled
FALLBACK_LLM_MODEL_ID=
FALLBACK_LLM_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clips
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_SOFT_LIMIT_BYTES=8589934592
R2_HARD_LIMIT_BYTES=10737418240
SCRATCH_LIMIT_BYTES=21474836480
MEDIA_TTL_HOURS=24
SEGMENT_SECONDS=600
MAX_CONCURRENT_STREAMS=3
AUTO_POST_ENABLED=false
ZERNIO_API_KEY=
ZERNIO_BASE_URL=VERIFY_FROM_OFFICIAL_DOCS
ZERNIO_ACCOUNT_IDS=
